{
    "System": {
        "Server": {
            "ContentType": {
                "create": {
                  "validate": {
                    "uuid": [
                        {
                            "is.uuid": true
                        }
                    ],
                    "extension": [
                        {
                            "is.unique": {
                                "class": "System.Server.ContentType",
                                "attribute": [
                                    "extension"
                                ]
                            }
                        }
                    ]
                  }
                },
                "put": {
                  "validate": {
                    "uuid": [
                      {
                        "is.uuid": true
                      }
                    ],
                    "extension": [
                      {
                        "is.unique": {
                          "class": "System.Server.ContentType",
                          "attribute": [
                            "extension"
                          ]
                        }
                      }
                    ]
                  }
                },
                "patch": {
                  "options": {
                    "or": [
                      {
                        "left": [
                          "extension"
                        ],
                        "right": [
                          "file_extension"
                        ]
                      }
                    ],
                    "xor": [
                      {
                        "#example": "...",
                        "left": [
                          "(uuid && extension) || (uuid && file_extension) || (extension && file_extension)",
                          "extension"
                        ],
                        "right": [
                          "file_extension"
                        ]
                      }
                    ]
                  },
                  "validate": {
                    "uuid": [
                      {
                        "is.uuid": true
                      }
                    ],
                    "?extension": [
                      {
                        "is.unique": {
                          "class": "System.Server.ContentType",
                          "attribute": [
                            "extension"
                          ]
                        }
                      }
                    ]
                  }
                }
            }
        }
    }
}