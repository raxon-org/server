{
    "System": {
        "Server": {
            "Extension": {
                "create": {
                  "validate": {
                    "uuid": [
                        {
                            "is.uuid": true
                        }
                    ],
                    "name": [
                        {
                            "is.unique": {
                                "class": "System.Server.Extension",
                                "attribute": [
                                    "name"
                                ]
                            }
                        }
                    ]
                  }
                },
                "put": {
                  "validate": {
                    "uuid": [
                      {
                        "is.uuid": true
                      }
                    ],
                    "name": [
                      {
                        "is.unique": {
                          "class": "System.Server.Extension",
                          "attribute": [
                            "name"
                          ]
                        }
                      }
                    ]
                  }
                },
                "patch": {
                  "validate": {
                    "uuid": [
                      {
                        "is.uuid": true
                      }
                    ],
                    "?name": [
                      {
                        "is.unique": {
                          "class": "System.Server.Extension",
                          "attribute": [
                            "name"
                          ]
                        }
                      }
                    ]
                  }
                }
            }
        }
    }
}